from dataclasses import dataclass
import time

REALM_INTAKE_RULES = {
    "Physical": {"weight": 1.0, "stability": 0.98},
    "Quantum": {"weight": 1.3, "stability": 0.85},
    "Temporal": {"weight": 1.5, "stability": 0.90},
    "Simulated": {"weight": 0.9, "stability": 0.99},
    "Parallel": {"weight": 1.2, "stability": 0.88}
}

INTAKE_FIELDS = [
    "income_monthly",
    "household_size",
    "disconnect_notice",
    "sdg_vector",
    "program"
]

@dataclass
class RealmIntake:
    realm: str
    data: dict  # {field: value}
    confidence: float  # 0.0–1.0

@dataclass
class UniversalIntakeRequest:
    member_id: str
    name: str
    realms: list  # list[RealmIntake]

def compute_realm_weight(realm: str, confidence: float):
    if realm not in REALM_INTAKE_RULES:
        return 0
    r = REALM_INTAKE_RULES[realm]
    return round(confidence * r["weight"] * r["stability"], 4)

