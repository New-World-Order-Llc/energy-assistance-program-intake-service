INTAKE_SCHEMA = {
    "member_id": {
        "type": "string",
        "required": True,
        "description": "Unique Beast System 3.0 member identifier."
    },
    "name": {
        "type": "string",
        "required": True,
        "description": "Applicant full legal name."
    },
    "county": {
        "type": "string",
        "required": True,
        "allowed": ["Vigo", "Clay", "Sullivan", "Vermillion", "Parke"],
        "description": "County of residence for routing."
    },
    "income_monthly": {
        "type": "number",
        "required": True,
        "min": 0,
        "description": "Total monthly household income."
    },
    "household_size": {
        "type": "integer",
        "required": True,
        "min": 1,
        "max": 10,
        "description": "Number of people living in the household."
    },
    "disconnect_notice": {
        "type": "boolean",
        "required": True,
        "description": "Whether the applicant has an active utility disconnect notice."
    },
    "utility_vendor": {
        "type": "string",
        "required": True,
        "description": "Utility provider (e.g., Duke Energy, AES Indiana)."
    }
}

def validate(payload: dict):
    errors = []

    for field, rules in INTAKE_SCHEMA.items():
        if rules["required"] and field not in payload:
            errors.append(f"Missing required field: {field}")
            continue

        value = payload.get(field)

        if rules["type"] == "string" and not isinstance(value, str):
            errors.append(f"{field} must be a string.")

        if rules["type"] == "number" and not isinstance(value, (int, float)):
            errors.append(f"{field} must be numeric.")

        if rules["type"] == "integer" and not isinstance(value, int):
            errors.append(f"{field} must be an integer.")

        if rules["type"] == "boolean" and not isinstance(value, bool):
            errors.append(f"{field} must be boolean.")

        if "min" in rules and isinstance(value, (int, float)) and value < rules["min"]:
            errors.append(f"{field} must be >= {rules['min']}.")

        if "max" in rules and isinstance(value, (int, float)) and value > rules["max"]:
            errors.append(f"{field} must be <= {rules['max']}.")

        if "allowed" in rules and value not in rules["allowed"]:
            errors.append(f"{field} must be one of {rules['allowed']}.")

    return {"valid": len(errors) == 0, "errors": errors}


def demo():
    sample = {
        "member_id": "LUCR-001",
        "name": "John Doe",
        "county": "Vigo",
        "income_monthly": 1500,
        "household_size": 2,
        "disconnect_notice": True,
        "utility_vendor": "Duke Energy"
    }

    print(validate(sample))


if __name__ == "__main__":
    demo()
