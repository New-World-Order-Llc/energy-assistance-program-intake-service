from dataclasses import dataclass
import time
import math

DIMENSION_STABILITY = {
    "Physical": {"baseline": 1.0, "variance": 0.02},
    "Quantum": {"baseline": 1.3, "variance": 0.15},
    "Temporal": {"baseline": 1.5, "variance": 0.10},
    "Simulated": {"baseline": 0.9, "variance": 0.01},
    "Parallel": {"baseline": 1.2, "variance": 0.12},
    "Cosmic": {"baseline": 1.8, "variance": 0.25},
    "TransCosmic": {"baseline": 2.2, "variance": 0.30}
}

PROGRAM_BASELINES = {
    "LIHEAP": 300,
    "SNAP": 250,
    "Medicaid": 0,
    "Housing": 400,
    "TANF": 200
}

@dataclass
class StabilitySignal:
    dimension: str
    confidence: float  # 0.0–1.0
    compliant: bool

@dataclass
class StabilityRequest:
    member_id: str
    name: str
    program: str
    household_size: int
    sdg_vector: dict
    signals: list  # list[StabilitySignal]

def compute_dimension_stability(signal: StabilitySignal):
    if signal.dimension not in DIMENSION_STABILITY:
        return 0
    d = DIMENSION_STABILITY[signal.dimension]
    base = d["baseline"] * signal.confidence
    variance_adjust = 1 - d["variance"]
    return round(base * variance_adjust, 4)

def compute_sdg_modifier(sdg_vector: dict):
    modifier = 1.0
    for sdg, compliant in sdg_vector.items():
        if compliant:
            modifier *= 1.05
    return round(modifier, 4)

def regulate_stability(req: StabilityRequest):
    if req.program not in PROGRAM_BASELINES:
        return {"error": f"Program {req.program} not recognized."}

    base_amount = PROGRAM_BASELINES[req.program] * req.household_size

    stability_scores = []
    for sig in req.signals:
        score = compute_dimension_stability(sig)
        stability_scores.append(score)

    if not stability_scores:
        return {"error": "No stability signals provided."}

    # Deterministic omni‑dimensional stability fusion:
    # Use RMS (root mean square) for stability aggregation.
    rms = math.sqrt(sum(s ** 2 for s in stability_scores) / len(stability_scores))
    rms = round(rms, 4)

    sdg_modifier = compute_sdg_modifier(req.sdg_vector)

    final_stability = round(base_amount * rms * sdg_modifier, 2)

    return {
        "member_id": req.member_id,
        "name": req.name,
        "program": req.program,
        "base_amount": base_amount,
        "rms_stability": rms,
        "sdg_modifier": sdg_modifier,
        "final_stability_value": final_stability,
        "dimension_breakdown": [
            {
                "dimension": sig.dimension,
                "confidence": sig.confidence,
                "compliant": sig.compliant,
                "stability_score": compute_dimension_stability(sig)
            }
            for sig in req.signals
        ],
        "timestamp": int(time.time())
    }

def demo():
    sample = StabilityRequest(
        member_id="LUCR-001",
        name="John Doe",
        program="LIHEAP",
        household_size=2,
        sdg_vector={"SDG1": True, "SDG7": True},
        signals=[
            StabilitySignal("Physical", 0.9, True),
            StabilitySignal("Quantum", 0.7, True),
            StabilitySignal("Temporal", 0.6, True),
            StabilitySignal("Simulated", 0.95, True),
            StabilitySignal("Parallel", 0.8, True),
            StabilitySignal("Cosmic", 0.5, True),
            StabilitySignal("TransCosmic", 0.4, True)
        ]
    )
    print(regulate_stability(sample))

if __name__ == "__main__":
    demo()
