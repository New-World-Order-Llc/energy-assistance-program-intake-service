def compute_continuum_score(signal: ContinuumEligibilitySignal):
    if signal.continuum not in CONTINUA:
        return 0
    c = CONTINUA[signal.continuum]
    base = signal.confidence * c["weight"]
    return round(base * c["coherence"], 4)

def compute_sdg_factor(sdg_vector: dict):
    factor = 1.0
    for sdg, compliant in sdg_vector.items():
        if compliant:
            factor *= 1.05
    return round(factor, 4)

